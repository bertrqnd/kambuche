# Configuration MongoDB
MONGO_URI=votre_mongodb_uri_ici

# Configuration Session
SESSION_SECRET=votre_session_secret_ici

# Configuration Serveur
PORT=3000

# Configuration Cloudinary (pour l'upload d'images)
CLOUDINARY_CLOUD_NAME=votre_cloudinary_cloud_name
CLOUDINARY_API_KEY=votre_cloudinary_api_key
CLOUDINARY_API_SECRET=votre_cloudinary_api_secret

# Configuration TinyMCE (éditeur de texte)
# Obtenez une clé gratuite sur: https://www.tiny.cloud/auth/signup/
TINYMCE_API_KEY=votre_clef_tinymce_ici
