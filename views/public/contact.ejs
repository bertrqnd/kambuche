<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= meta.title %></title>
  <meta name="description" content="<%= meta.description %>">
    <!-- Favicons -->
    <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/contact.css">
</head>
<body>
  <!-- === NAVBAR === -->
  <header class="navbar">
    <span class="nav-left">
      <a href="/" class="andrea-link">
        <span class="first-name">Andrea</span><span class="last-name">Layton</span>
      </a>
    </span>
    <div class="nav-links">
      <a href="/" class="nav-item">Retour</a>
    </div>
  </header>

  <!-- === MAIN CONTACT === -->
  <main class="contact-page">
    <h1 class="visually-hidden">Contact</h1>
    <div class="contact-container">
      <div class="contact-info">
        <% if (page.email) { %>
          <div class="contact-item">
            <span class="contact-value"><%= page.email %></span>
            <button class="copy-btn" data-copy="<%= page.email %>">Copier</button>
          </div>
        <% } %>

        <% if (page.phone) { %>
          <div class="contact-item">
            <span class="contact-value"><%= page.phone %></span>
            <button class="copy-btn" data-copy="<%= page.phone %>">Copier</button>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <script src="/js/page-transition.js"></script>
  <script src="/js/contact.js"></script>
</body>
</html>