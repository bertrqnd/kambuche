<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= meta.title %></title>
<meta name="description" content="<%= meta.description %>">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header>
<h1>Andrea Layton - Architecte</h1>
<nav>
<a href="/">Accueil</a>
<a href="/projets">Projets</a>
<a href="/a-propos">À propos</a>
<a href="/contact">Contact</a>
</nav>
</header>
<main>
<article>
<h2><%= project.title %></h2>

<!-- Image de couverture -->
<% if(project.cover_image_url) { %>
    <img src="<%= project.cover_image_url %>" alt="<%= project.title %> - couverture" style="max-width:100%;">
<% } %>

<!-- Galerie d'images -->
<% if(project.images_url && project.images_url.length > 0) { %>
    <div class="gallery">
        <% project.images_url.forEach(img => { %>
            <img src="<%= img %>" alt="<%= project.title %>" style="max-width:200px; margin:5px;">
        <% }) %>
    </div>
<% } %>

<p><%= project.description %></p>
<p><em>Publié le <%= project.date.toLocaleDateString('fr-FR') %></em></p>
</article>
</main>
<footer>
<p>&copy; <%= new Date().getFullYear() %> Andrea Layton</p>
</footer>
</body>
</html>
