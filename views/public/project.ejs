<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= meta.title %></title>
  <meta name="description" content="<%= meta.description %>">

  <!-- Favicons et meta tags SEO -->
  <%- include('partials/head') %>

  <link rel="stylesheet" href="/css/project.css">
</head>
<body>
  <header class="navbar">
    <span class="nav-left">
      <a href="/" class="andrea-link">
        <span class="first-name">Andrea</span><span class="last-name">Layton</span>
      </a>
    </span>
    <div class="nav-links">
      <a href="/" class="nav-item">Retour</a>
    </div>
  </header>

  <main>
    <div class="project-container">
      <!-- Carousel 2/3 gauche -->
      <div class="project-carousel">
        <% if(project.cover_image_url || (project.images_url && project.images_url.length > 0)) { %>
          <% let allImages = [project.cover_image_url].concat(project.images_url.filter(img => img !== project.cover_image_url)); %>
          <% allImages.forEach((img, index) => { %>
            <% const imgData = cloudinaryResponsive(img, [800, 1200, 1600, 2400]) %>
            <div class="carousel-slide">
              <img
                src="<%= imgData.src %>"
                srcset="<%= imgData.srcset %>"
                sizes="(max-width: 768px) 100vw, 66vw"
                alt="<%= project.title %> - Image <%= index + 1 %>"
                width="1200"
                height="800"
                <% if (index === 0) { %>fetchpriority="high"<% } else { %>loading="lazy"<% } %>
              >
            </div>
          <% }) %>
          <button class="carousel__btn carousel__btn--prev"></button>
          <button class="carousel__btn carousel__btn--next"></button>
          <div class="carousel__indicators"></div>
        <% } %>
      </div>

      <!-- Texte projet 1/3 droite -->
      <div class="project-text">
        <% if(project.usage || project.surface || project.location_year) { %>
          <p class="project-metadata-line">
            <% let metaParts = []; %>
            <% if(project.usage) metaParts.push(project.usage); %>
            <% if(project.surface) metaParts.push(project.surface); %>
            <% if(project.location_year) metaParts.push(project.location_year); %>
            <%= metaParts.join(' | ') %>
          </p>
        <% } %>

        <h1 class="project-title"><%= project.title %></h1>
        <p class="project-short-desc"><%= project.short_description %></p>

        <div class="project-description tinymce-content">
          <%- sanitize(project.description) %>
        </div>
      </div>
    </div>
  </main>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox">
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-content">
      <div class="lightbox-slides"></div>
      <button id="lightbox-prev" class="lightbox-btn lightbox-prev"></button>
      <button id="lightbox-next" class="lightbox-btn lightbox-next"></button>
      <span id="lightbox-close" class="lightbox-close">&times;</span>
    </div>
  </div>

  <script src="/js/page-transition.js"></script>
  <script src="/js/project-carousel.js"></script>
</body>
</html>