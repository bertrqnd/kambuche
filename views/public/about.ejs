<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= meta.title %></title>
  <meta name="description" content="<%= meta.description %>">
  <!-- Favicons -->
    <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/about.css">
</head>
<body>
  <!-- === NAVBAR === -->
  <header class="navbar">
    <span class="nav-left">
      <a href="/" class="andrea-link">
        <span class="first-name">Andrea</span><span class="last-name">Layton</span>
      </a>
    </span>
    <div class="nav-links">
      <a href="/" class="nav-item">Retour</a>
    </div>
  </header>

  <!-- === MAIN À PROPOS === -->
  <main class="about-page">
    <div class="about-container">
      <% if (page.image_url) { %>
        <div class="about-image">
          <img src="<%= page.image_url %>" alt="À propos">
        </div>
      <% } %>
      <div class="about-content tinymce-content">
        <%- sanitize(page.content) %>
      </div>
    </div>
  </main>
</body>
</html>



           