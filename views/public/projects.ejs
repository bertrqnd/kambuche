<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= meta.title %></title>
  <meta name="description" content="<%= meta.description %>">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- === NAVBAR === -->
<header class="navbar">
  <span class="nav-left">
    <span class="first-name">Andrea</span><span class="last-name">Layton</span>
  </span>

  <div class="nav-links">
  <a href="/a-propos" class="nav-item">À propos</a>
  <a href="/contact" class="nav-item">Contact</a>

    <div class="dropdown">
      <a href="#" class="nav-item dropdown-btn">Projets</a>
      <ul class="dropdown-menu">
        <% projects.forEach(project => { %>
          <li><a href="/projets/<%= project.slug %>"><%= project.title %></a></li>
        <% }) %>
      </ul>
    </div>
  </div>

  <!-- menu burger -->
  <div class="burger">
  <span></span>
  <span></span>
  <span></span>
</div>

</header>


<main>
  <!-- Données pour le carousel -->
<div id="carousel-data" data-projects='<%= JSON.stringify(carouselProjects) %>'></div>




  <!-- Carousel -->
  <%- include('partials/carousel') %>
</main>

<script src="/js/carousel.js"></script>
</body>
</html>
