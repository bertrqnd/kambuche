<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= meta.title %></title>
<meta name="description" content="<%= meta.description %>">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header>
  <h1>Andrea Layton - Architecte</h1>
  <nav>
    <a href="/">Accueil</a>
    <a href="/projets">Projets</a>
    <a href="/a-propos">À propos</a>
    <a href="/contact">Contact</a>
  </nav>
</header>

<main>
  <h2>Derniers projets</h2>
  <div class="projects">
    <% projects.forEach(project => { %>
      <div class="project-card">
        <a href="/projets/<%= project.slug %>">
          
          <% if (project.cover_image_url) { %>
            <!-- Affiche l’image de couverture -->
            <img src="<%= project.cover_image_url %>" alt="<%= project.title %>" style="max-width:100%;">
          <% } else if (project.images_url && project.images_url.length > 0) { %>
            <!-- Si pas de couverture, affiche la première image de la galerie -->
            <img src="<%= project.images_url[0] %>" alt="<%= project.title %>" style="max-width:100%;">
          <% } else { %>
            <!-- Si aucune image, affiche un bloc gris -->
            <div style="width:100%;height:200px;background:#ccc;"></div>
          <% } %>

          <h3><%= project.title %></h3>
        </a>
      </div>
    <% }) %>
  </div>
</main>

<footer>
  <p>&copy; <%= new Date().getFullYear() %> Andrea Layton</p>
</footer>
</body>
</html>
