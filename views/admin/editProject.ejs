<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Modifier Projet</title>
  <link rel="stylesheet" href="/css/editProject.css">
  <script src="/js/adminProject.js" defer></script>
  <script src="/node_modules/tinymce/tinymce.js" defer></script>
</head>
<body>
  <h1>Modifier le projet</h1>
  
  <form action="/admin/projects/edit/<%= project._id %>" method="post" enctype="multipart/form-data">
    <label for="title">Titre :</label>
    <input type="text" id="title" name="title" value="<%= project.title %>" required>
    
    <label for="description">Description :</label>
    <textarea id="description" name="description" required><%= project.description %></textarea>
    
    <!-- Image de couverture actuelle -->
    <label>Image de couverture actuelle :</label>
    <% if(project.cover_image_url) { %>
      <div class="cover-container">
        <img src="<%= project.cover_image_url %>" alt="Couverture actuelle">
        <form action="/admin/projects/delete-image" method="post" class="delete-image-form" onsubmit="return confirm('Supprimer cette image ?');">
          <input type="hidden" name="projectId" value="<%= project._id %>">
          <input type="hidden" name="imageUrl" value="<%= project.cover_image_url %>">
          <input type="hidden" name="type" value="cover">
          <button type="submit" class="delete-image-btn">✕</button>
        </form>
      </div>
    <% } else { %>
      <p style="color:#888;font-style:italic;">Aucune image de couverture</p>
    <% } %>
    
    <!-- Remplacer image de couverture -->
    <label for="cover_image">Remplacer l'image de couverture :</label>
    <input type="file" id="cover_image" name="cover_image" accept="image/*">

    <!-- Galerie actuelle -->
    <label>Galerie actuelle :</label>
    <% if(project.images_url && project.images_url.length > 0){ %>
      <div class="gallery-container">
        <% project.images_url.forEach(img => { %>
          <div class="image-container">
            <img src="<%= img %>" alt="Image projet">
            <form action="/admin/projects/delete-image" method="post" class="delete-image-form" onsubmit="return confirm('Supprimer cette image ?');">
              <input type="hidden" name="projectId" value="<%= project._id %>">
              <input type="hidden" name="imageUrl" value="<%= img %>">
              <input type="hidden" name="type" value="gallery">
              <button type="submit" class="delete-image-btn">✕</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p style="color:#888;font-style:italic;">Aucune image dans la galerie</p>
    <% } %>

    <!-- Ajouter nouvelles images par lot -->
    <label for="new_images">Ajouter de nouvelles images :</label>
    <input type="file" id="new_images" name="new_images" accept="image/*" multiple>

    <button type="submit">Sauvegarder les modifications</button>
  </form>
  
  <a href="/admin/projects" class="back-link">Retour aux projets</a>
</body>
</html>
