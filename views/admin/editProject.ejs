<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Admin - Modifier Projet</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/admin-project-form.css">
  <script src="https://cdn.tiny.cloud/1/<%= tinymceApiKey %>/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>
  <script src="/js/tinymce-config.js"></script>
</head>
<body>
  <div class="admin-header">
    <h1>Modifier le projet</h1>
    <a href="/admin/projects" class="btn-secondary header-back-btn">Retour</a>
  </div>
  
  <form action="/admin/projects/edit/<%= project._id %>" method="post" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="title">Titre du projet :</label>
    <input type="text" id="title" name="title" value="<%= project.title %>" required>
    
    <label for="short_description">Description rapide (page d'accueil) :</label>
    <input type="text" id="short_description" name="short_description" 
           value="<%= project.short_description %>" required>
    
    <label for="usage">Usage :</label>
    <input type="text" id="usage" name="usage" value="<%= project.usage || '' %>">
    
    <label for="surface">Surface :</label>
    <input type="text" id="surface" name="surface" value="<%= project.surface || '' %>">
    
    <label for="location_year">Ville / Année :</label>
    <input type="text" id="location_year" name="location_year" value="<%= project.location_year || '' %>">
    
    <label for="description">Description complète :</label>
    <textarea id="description" name="description" required><%= project.description %></textarea>

    <label>Image de couverture :</label>
    <% if(project.cover_image_url) { %>
      <div class="existing-images-container">
        <div class="existing-image-item">
          <img src="<%= project.cover_image_url %>" alt="Couverture">
          <button type="button" class="delete-image-btn" data-project-id="<%= project._id %>" data-image-url="<%= project.cover_image_url %>" data-type="cover">✕</button>
        </div>
      </div>
    <% } %>
    <input type="file" id="cover_image" name="cover_image" accept="image/*" style="display: none;">
    <div class="upload-zone" id="coverZone">
      <div class="upload-zone-text">Cliquez ou glissez une image ici</div>
      <div class="upload-zone-hint">Remplacer l'image de couverture</div>
    </div>
    <div id="coverPreview" class="image-preview-container"></div>

    <label>Images de la galerie :</label>
    <% if(project.images_url && project.images_url.length > 0) { %>
      <div class="existing-images-container" id="existingImagesContainer">
        <% project.images_url.forEach(img => { %>
          <div class="existing-image-item" draggable="true" data-image-url="<%= img %>">
            <img src="<%= img %>" alt="Image">
            <button type="button" class="delete-image-btn" data-project-id="<%= project._id %>" data-image-url="<%= img %>" data-type="gallery">✕</button>
            <div class="drag-handle">⋮⋮</div>
          </div>
        <% }) %>
      </div>
      <input type="hidden" id="gallery_order" name="gallery_order" value="">
    <% } %>
    <input type="file" id="new_images" name="new_images" accept="image/*" multiple style="display: none;">
    <div class="upload-zone" id="additionalZone">
      <div class="upload-zone-text">Cliquez ou glissez des images ici</div>
      <div class="upload-zone-hint">Ajouter de nouvelles images à la galerie</div>
    </div>
    <div id="additionalPreview" class="image-preview-container"></div>

    <div class="form-actions">
      <div class="submit-btn-wrapper" id="submitWrapper">
        <button type="submit" class="btn btn-primary">Sauvegarder les modifications</button>
        <div class="submit-loader">
          <div class="spinner"></div>
        </div>
      </div>
      <a href="/admin/projects" class="btn btn-secondary">Retour</a>
    </div>
  </form>

  <script src="/js/admin-edit-project.js"></script>
</body>
</html>