<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Modifier un projet</title>
  <link rel="stylesheet" href="/css/editProject.css">
</head>
<body>
  <h1>Modifier le projet</h1>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <form action="/admin/projects/edit/<%= project._id %>" method="POST" enctype="multipart/form-data">
    <label for="title">Titre :</label>
    <input type="text" id="title" name="title" value="<%= project.title %>" required>

    <label for="description">Description :</label>
    <textarea id="description" name="description"><%= project.description %></textarea>

    <label>Image de couverture actuelle :</label>
    <% if (project.coverImageUrl) { %>
      <div class="cover-container">
        <img src="<%= project.coverImageUrl %>" alt="Image de couverture">
      </div>
    <% } %>

    <label for="coverImage">Changer l’image de couverture :</label>
    <input type="file" id="coverImage" name="coverImage" accept="image/*">

    <label>Galerie d’images actuelle :</label>
    <div class="gallery-container">
      <% project.images.forEach(image => { %>
        <div class="image-container">
          <img src="<%= image.url %>" alt="">
          <form class="delete-image-form" action="/admin/projects/<%= project._id %>/delete-image" method="POST">
            <input type="hidden" name="public_id" value="<%= image.public_id %>">
            <button type="submit" class="delete-image-btn">✕</button>
          </form>
        </div>
      <% }) %>
    </div>

    <label for="images">Ajouter de nouvelles images :</label>
    <input type="file" id="images" name="images" accept="image/*" multiple>

    <button type="submit">Enregistrer les modifications</button>
  </form>

  <a href="/admin/projects" class="back-link">← Retour</a>

  <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>
  <script src="/js/admin-project.js"></script>
</body>
</html>
