<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin - Modifier Projet</title>
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<h1>Modifier le projet</h1>
<form action="/admin/projects/edit/<%= project._id %>" method="post" enctype="multipart/form-data">
<label for="title">Titre :</label>
<input type="text" id="title" name="title" value="<%= project.title %>" required>


<label for="description">Description :</label>
<textarea id="description" name="description" required><%= project.description %></textarea>


<label for="image">Image :</label>
<% if(project.image_url) { %>
<img src="<%= project.image_url %>" alt="<%= project.title %>" width="150">
<% } %>
<input type="file" id="image" name="image">


<button type="submit">Enregistrer</button>
</form>
<a href="/admin/projects">Retour aux projets</a>
</body>
</html>