<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Ajouter un projet</title>
  <link rel="stylesheet" href="/css/addProject.css">
</head>
<body>
  <h1>Ajouter un projet</h1>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <form action="/admin/projects/add" method="POST" enctype="multipart/form-data">
    <label for="title">Titre :</label>
    <input type="text" id="title" name="title" required>

    <label for="description">Description :</label>
    <textarea id="description" name="description"></textarea>

    <label for="coverImage">Image de couverture :</label>
    <input type="file" id="coverImage" name="coverImage" accept="image/*">

    <label for="images">Galerie d’images :</label>
    <input type="file" id="images" name="images" accept="image/*" multiple>

    <button type="submit">Ajouter le projet</button>
  </form>

  <a href="/admin/projects" class="back-link">← Retour</a>

  <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>
  <script src="/js/admin-project.js"></script>
</body>
</html>
