<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Ajouter Projet</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/admin-project-form.css">
  <script src="https://cdn.tiny.cloud/1/<%= tinymceApiKey %>/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>
  <script src="/js/tinymce-config.js"></script>
</head>
<body>
  <div class="admin-header">
    <h1>Ajouter un projet</h1>
  </div>

  <form action="/admin/projects/add" method="post" enctype="multipart/form-data" id="projectForm" class="page-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
      <label for="language">Langue :</label>
      <select id="language" name="language" required>
        <option value="fr">Français</option>
        <option value="en">English</option>
        <option value="es">Español</option>
      </select>
    </div>

    <div class="form-group">
      <label for="title">Titre du projet :</label>
      <input type="text" id="title" name="title" placeholder="Ex: COMMERCES CAPITOLE" required>
    </div>

    <div class="form-group">
      <label for="short_description">Description rapide (page d'accueil) :</label>
      <input type="text" id="short_description" name="short_description"
             placeholder="Ex: Transformation de deux anciens studios en commerces, Toulouse" required>
    </div>

    <div class="form-group">
      <label for="usage">Usage :</label>
      <input type="text" id="usage" name="usage" placeholder="Ex: Bureaux, Logement, Commerce...">
    </div>

    <div class="form-group">
      <label for="surface">Surface :</label>
      <input type="text" id="surface" name="surface" placeholder="Ex: 64.7 et 93.6 m²">
    </div>

    <div class="form-group">
      <label for="location_year">Ville / Année :</label>
      <input type="text" id="location_year" name="location_year" placeholder="Ex: Toulouse 2023">
    </div>

    <div class="form-group">
      <label for="description">Description complète :</label>
      <textarea id="description" name="description"></textarea>
      <span id="descriptionError" style="color: #ff6b6b; font-size: 14px; display: none; margin-top: 5px;">Veuillez saisir une description</span>
    </div>

    <div class="form-group">
      <label for="cover_image">Image de couverture :</label>
      <input type="file" id="cover_image" name="cover_image" accept="image/*" style="display: none;">
      <div class="upload-zone" id="coverZone">
        <div class="upload-zone-text">Cliquez ou glissez une image ici</div>
        <div class="upload-zone-hint">Image de couverture (obligatoire)</div>
      </div>
      <div id="coverPreview" class="image-preview-container"></div>
      <span id="coverError" style="color: #ff6b6b; font-size: 14px; display: none; margin-top: 5px;">Veuillez sélectionner une image de couverture</span>
    </div>

    <div class="form-group">
      <label>Images supplémentaires :</label>
      <input type="file" id="additional_images" name="images" accept="image/*" multiple style="display: none;">
      <div class="upload-zone" id="additionalZone">
        <div class="upload-zone-text">Cliquez ou glissez des images ici</div>
        <div class="upload-zone-hint">Vous pouvez sélectionner plusieurs images</div>
      </div>
      <div id="additionalPreview" class="image-preview-container"></div>
    </div>

    <div class="form-actions">
      <div class="submit-btn-wrapper" id="submitWrapper">
        <button type="submit" class="btn btn-primary">Ajouter le projet</button>
        <div class="submit-loader">
          <div class="spinner"></div>
        </div>
      </div>
      <a href="/admin/projects" class="btn btn-secondary">Retour</a>
    </div>
  </form>

  <script src="/js/admin-project-form.js"></script>
</body>
</html>
