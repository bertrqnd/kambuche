<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Gérer les pages</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-header">
    <h1>Gérer les pages du site</h1>
    <div class="admin-nav">
      <a href="/admin/projects" class="nav-link">Projets</a>
      <a href="/admin/pages" class="nav-link active">Pages</a>
      <a href="/admin/logout" class="nav-link logout">Déconnexion</a>
    </div>
  </div>

  <div class="pages-grid">
    <div class="page-card">
      <h2>À propos</h2>
      <p>Modifier le contenu de la page "À propos"</p>
      <a href="/admin/pages/edit/about" class="btn btn-primary">Modifier</a>
    </div>

    <div class="page-card">
      <h2>Contact</h2>
      <p>Modifier le contenu de la page "Contact"</p>
      <a href="/admin/pages/edit/contact" class="btn btn-primary">Modifier</a>
    </div>
  </div>
</body>
</html>
