<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Modifier <%= page.title %></title>
  <link rel="stylesheet" href="/css/admin.css">
  <script src="https://cdn.tiny.cloud/1/<%= tinymceApiKey %>/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>
  <script src="/js/tinymce-config.js"></script>
</head>
<body>
  <div class="admin-header">
    <h1>Modifier : <%= page.title %></h1>
  </div>

  <form action="/admin/pages/edit/<%= page.slug %>" method="post" enctype="multipart/form-data" class="page-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <!-- Le titre est caché mais toujours envoyé pour maintenir la cohérence de la DB -->
    <input type="hidden" id="title" name="title" value="<%= page.title %>">

    <% if (page.slug === 'contact') { %>
      <!-- Champs spécifiques pour Contact -->
      <div class="form-group">
        <label for="email">Email :</label>
        <input type="email" id="email" name="email" value="<%= page.email || '' %>" placeholder="contact@example.com">
      </div>

      <div class="form-group">
        <label for="phone">Numéro de téléphone :</label>
        <input type="text" id="phone" name="phone" value="<%= page.phone || '' %>" placeholder="+33 6 12 34 56 78">
      </div>

      <!-- Le contenu est caché pour Contact mais maintenu pour la DB -->
      <input type="hidden" id="content" name="content" value="<%= page.content %>">
    <% } else { %>
      <!-- Pour les autres pages (À propos), afficher le contenu -->

      <!-- Image de la page À propos -->
      <div class="form-group">
        <label>Image :</label>
        <% if (page.image_url) { %>
          <div class="existing-image" style="margin-bottom: 15px;">
            <img src="<%= page.image_url %>" alt="Image À propos" style="max-width: 300px; border-radius: 4px;">
          </div>
        <% } %>
        <input type="file" id="image" name="image" accept="image/*">
        <small style="display: block; margin-top: 5px; color: #666;">
          <%= page.image_url ? 'Uploader une nouvelle image pour remplacer l\'actuelle' : 'Ajouter une image en haut du contenu' %>
        </small>
      </div>

      <div class="form-group">
        <label for="content">Contenu :</label>
        <textarea id="content" name="content" required><%= page.content %></textarea>
      </div>
    <% } %>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Sauvegarder</button>
      <a href="/admin/pages" class="btn btn-secondary">Retour</a>
    </div>
  </form>

  <% if (page.slug === 'about') { %>
  <script src="/js/admin-edit-page.js"></script>
  <% } %>
</body>
</html>
